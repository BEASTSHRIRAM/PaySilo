# Copy to .env and fill in when going live. Demo mode needs NONE of these.

# demo (default) uses the in-memory Airwallex simulator.
# Set APP_ENV=live with real Airwallex sandbox keys to use the REST client.
APP_ENV=demo

# Airwallex sandbox (platform access must be requested from Airwallex;
# 3 connected accounts are enabled for Starter Kit 6 teams)
AIRWALLEX_CLIENT_ID=
AIRWALLEX_API_KEY=
AIRWALLEX_BASE_URL=https://api-demo.airwallex.com/api/v1

# Claude — intake/explanation LLM only. Without it, a deterministic
# fallback parser handles structured demo input.
ANTHROPIC_API_KEY=

# PostgreSQL (docker-compose provides one; schema in backend/db/schema.sql)
DATABASE_URL=postgresql://paysilo:paysilo@localhost:5432/paysilo

# Metal L2 testnet attestation. Until all three are set, the Metal chain
# fails closed and the offline mock chain is used instead.
METAL_RPC_URL=
METAL_PRIVATE_KEY=
METAL_REGISTRY_ADDRESS=
