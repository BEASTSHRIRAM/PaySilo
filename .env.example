# Copy to .env (repo root or backend/) and fill in when going live.
# Demo mode needs NONE of these: no keys, no database, no setup.

# demo (default) uses the in-memory Airwallex simulator and seeds the demo org.
# live uses the real Airwallex sandbox REST client and requires JWT_SECRET.
APP_ENV=demo

# --- Airwallex sandbox (platform access is requested from Airwallex) ---
AIRWALLEX_CLIENT_ID=
AIRWALLEX_API_KEY=
AIRWALLEX_BASE_URL=https://api.sandbox.airwallex.com/api/v1
# Retries on HTTP 429 (sandbox: 10 req/s per endpoint), and how long to keep
# retrying FX on `unconfigured_client_fee` right after an account is activated.
AIRWALLEX_RATE_LIMIT_RETRIES=5
AIRWALLEX_FEE_CONFIG_RETRY_SECONDS=180
# Optional hosted onboarding: template id for the Airwallex hosted onboarding
# flow and the URL employers return to afterwards (live mode only).
AIRWALLEX_HOSTED_ONBOARDING_TEMPLATE=
AIRWALLEX_ONBOARDING_RETURN_URL=

# --- Claude: the Intake Agent's LLM only. Without a key a deterministic parser is used. ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- LangGraph checkpointer: durable paused runs ---
# CHECKPOINT_PATH=/data/paysilo-checkpoints.sqlite  (SQLite file checkpointer)
# When unset, a Postgres DATABASE_URL gives the Postgres checkpointer;
# otherwise paused runs live in memory only and do not survive a restart.
CHECKPOINT_PATH=

# --- Silo chat LLM (provider-agnostic) ---
# LLM_PROVIDER=anthropic (default) | openai | groq | meta. Without the
# selected provider's key, chat uses a deterministic fallback responder.
LLM_PROVIDER=anthropic
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
META_API_KEY=
META_MODEL=llama-3.3-70b-instruct
META_BASE_URL=https://api.llama.com/v1

# --- Database ---
# Supabase: Project Settings -> Database -> Connection string (URI). Either the
# direct connection (port 5432) or the transaction pooler (port 6543) works.
#   DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# Leave empty to use a local SQLite file (backend/paysilo.db).
DATABASE_URL=
# Create tables, ledger triggers and RLS on startup (or run db/schema.sql yourself).
AUTO_CREATE_SCHEMA=true

# --- Auth ---
# Long random string. Required in live mode; in demo mode a random one is
# generated per process (everyone is signed out on restart).
JWT_SECRET=
SESSION_TTL_MINUTES=720
# true behind HTTPS
COOKIE_SECURE=false
# JSON list of browser origins allowed to call the API directly
CORS_ORIGINS=["http://localhost:3000"]
# Seed the demo organization (ignored when APP_ENV=live)
SEED_DEMO=true

# --- docker-compose only: password for the bundled local Postgres ---
POSTGRES_PASSWORD=

# --- Compliance: 1099-NEC watch threshold (USD, calendar-year-to-date, US-person contractors).
# 2,000 applies to payments made after 2025-12-31 per vendor sources. Confirm with your tax advisor. ---
TAX_1099_THRESHOLD_USD=2000

# --- Visa TAP signing key ---
# PEM text or base64 (base64-encoded PEM, or a base64 raw 32-byte Ed25519 seed).
# When set, approvals verify across restarts (public keys are served at
# /.well-known/tap-keys). When empty, an ephemeral dev key is generated per
# process and logged as such — demo only.
TAP_PRIVATE_KEY=
TAP_KEY_ID=
TAP_AGENT_ID=paysilo-agent

# --- Metal L2 testnet attestation. Until all three are set the mock chain is used
# and MetalL2SettlementChain fails closed. ---
METAL_RPC_URL=
METAL_PRIVATE_KEY=
METAL_REGISTRY_ADDRESS=
# Optional block-explorer base URL for receipt links, e.g. https://explorer.example
METAL_EXPLORER_URL=

# --- Email outbox (funding reminders). console = simulated delivery (nothing leaves the machine);
# smtp = real delivery through the SMTP_* settings below. ---
EMAIL_PROVIDER=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Background funding-reminder sweep every 30 minutes (on|off). Assumes a single worker process.
FUNDING_REMINDERS=on
