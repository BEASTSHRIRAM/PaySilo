# Copy to .env (repo root or backend/) and fill in when going live.
# Demo mode needs NONE of these: no keys, no database, no setup.

# demo (default) uses the in-memory Airwallex simulator and seeds the demo org.
# live uses the real Airwallex sandbox REST client and requires JWT_SECRET.
APP_ENV=demo

# --- Airwallex sandbox (platform access is requested from Airwallex) ---
AIRWALLEX_CLIENT_ID=
AIRWALLEX_API_KEY=
AIRWALLEX_BASE_URL=https://api-demo.airwallex.com/api/v1

# --- Claude: the Intake Agent's LLM only. Without a key a deterministic parser is used. ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Database ---
# Supabase: Project Settings -> Database -> Connection string (URI). Either the
# direct connection (port 5432) or the transaction pooler (port 6543) works.
#   DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# Leave empty to use a local SQLite file (backend/paysilo.db).
DATABASE_URL=
# Create tables, ledger triggers and RLS on startup (or run db/schema.sql yourself).
AUTO_CREATE_SCHEMA=true

# --- Auth ---
# Long random string. Required in live mode; in demo mode a random one is
# generated per process (everyone is signed out on restart).
JWT_SECRET=
SESSION_TTL_MINUTES=720
# true behind HTTPS
COOKIE_SECURE=false
# JSON list of browser origins allowed to call the API directly
CORS_ORIGINS=["http://localhost:3000"]
# Seed the demo organization (ignored when APP_ENV=live)
SEED_DEMO=true

# --- docker-compose only: password for the bundled local Postgres ---
POSTGRES_PASSWORD=

# --- Metal L2 testnet attestation. Until all three are set the mock chain is used. ---
METAL_RPC_URL=
METAL_PRIVATE_KEY=
METAL_REGISTRY_ADDRESS=
