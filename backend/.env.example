
# --- Email (Brevo SMTP relay, STARTTLS). Leave BREVO_SMTP_USER / BREVO_SMTP_KEY empty and the notifications
# outbox only queues messages ("not configured"). EMAIL_FROM must be a sender verified in Brevo. ---
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_USER=
BREVO_SMTP_KEY=
EMAIL_FROM=
EMAIL_FROM_NAME=PaySilo
# Public URL of the web app, used for deep links in emails (e.g. approval requests).
APP_BASE_URL=http://localhost:3000
# Background funding sweep + email delivery loops (on|off). Assumes a single worker process.
FUNDING_REMINDERS=on
# Prepare (never approve) a continuation run when funds arrive for held lines (true|false).
AUTO_CONTINUE_HELD=true
